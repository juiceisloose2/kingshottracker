{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/data.json",
      "destination": "/public_export/data.json"
    },
    {
      "source": "/static/(.*)",
      "destination": "/public_export/static/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/public_export/index.html"
    }
  ]
}
